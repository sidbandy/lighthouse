# Lighthouse configuration.
# Copy to .env and edit. Every setting is read by pydantic-settings using the
# LIGHTHOUSE_ prefix; values shown here are the defaults used in local dev.

# Database URL. Local Postgres 16 with pgvector by default.
# For Supabase, use the Session pooler string from Connect -> Direct, port 5432
# (not the direct connection, which is IPv6-only; not 6543, which is the
# transaction pooler and does not support prepared statements). A bare
# postgresql:// scheme is rewritten to the psycopg driver automatically.
LIGHTHOUSE_DATABASE_URL=postgresql+psycopg://localhost/lighthouse

# Supabase, when deploying. Unset for local development.
# The publishable key is safe in a browser; the secret key is backend only and
# must never reach the frontend bundle.
LIGHTHOUSE_SUPABASE_URL=
LIGHTHOUSE_SUPABASE_PUBLISHABLE_KEY=
LIGHTHOUSE_SUPABASE_SECRET_KEY=

# Identifier for the single operator this instance belongs to. Rows are scoped to it.
LIGHTHOUSE_OPERATOR_ID=default

# Which engine generates summaries, fit rationales, and briefings.
# "rule_based" is fully offline: no API key, no network calls, no cost.
# Set to "gemini" only if you have supplied a key below.
LIGHTHOUSE_LLM_PROVIDER=rule_based

# OPTIONAL. Only needed when LIGHTHOUSE_LLM_PROVIDER=gemini. Leave blank otherwise.
LIGHTHOUSE_GEMINI_API_KEY=

# Gemini model name, ignored unless the gemini provider is active.
LIGHTHOUSE_GEMINI_MODEL=gemini-2.0-flash

# Local sentence-transformers model used for semantic search (extras: embeddings).
LIGHTHOUSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector width of the embedding model above. Must match the pgvector column size.
LIGHTHOUSE_EMBEDDING_DIM=384

# User-Agent sent by every outbound connector request. Keep it identifiable.
LIGHTHOUSE_USER_AGENT=lighthouse/0.1 (+self-hosted job search)

# Per-request timeout, in seconds, for outbound HTTP calls.
LIGHTHOUSE_HTTP_TIMEOUT_SECONDS=20

# --- The local voice pipeline for Practice (optional) ---
# Without these, Practice measures what a transcript can show and says so; the
# filler count stays a floor, because every transcriber drops "um". With them,
# filled pauses are measured from the audio itself. Nothing is uploaded
# anywhere and no recording is kept.
#
#   pip install -e "backend[voice]"
#   brew install whisper-cpp
#   mkdir -p models/weights
#   curl -sSL -o models/weights/silero_vad.onnx \
#     https://raw.githubusercontent.com/snakers4/silero-vad/v5.1/src/silero_vad/data/silero_vad.onnx
#   curl -sSL -o models/weights/ggml-base.en-q5_1.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en-q5_1.bin
#
# Paths below are the defaults and only need setting if you put them elsewhere.
# LIGHTHOUSE_WHISPER_BINARY=whisper-cli
# LIGHTHOUSE_WHISPER_MODEL=models/weights/ggml-base.en-q5_1.bin
# LIGHTHOUSE_VAD_MODEL=models/weights/silero_vad.onnx

# Largest recording the practice endpoint accepts, in bytes. ~8 minutes of
# 16 kHz mono audio; an answer past that has stopped being an answer.
# LIGHTHOUSE_MAX_AUDIO_BYTES=16000000

# --- New-posting alerts (optional) ---
# Twice-daily ingest into a list nobody has open gets read the next time
# somebody happens to look, which is the exact delay the freshness pipeline
# exists to remove. These make it reach you instead.
#
# Off entirely unless both ALERT_EMAIL_TO and SMTP_HOST are set, because a
# half-configured alerter produces silence that looks like "nothing new" —
# which is the one failure alerts must never have. Check what would be sent,
# with no account and no mail, using:
#
#   python -m lighthouse.cli alerts --dry-run
#
# LIGHTHOUSE_ALERT_EMAIL_TO=you@example.com
# LIGHTHOUSE_ALERT_EMAIL_FROM=lighthouse@example.com
# LIGHTHOUSE_SMTP_HOST=smtp.gmail.com
# LIGHTHOUSE_SMTP_PORT=587
# LIGHTHOUSE_SMTP_USERNAME=you@example.com
# For Gmail this is an app password, not the account password.
# LIGHTHOUSE_SMTP_PASSWORD=
# LIGHTHOUSE_SMTP_USE_TLS=true

# Only postings scoring at least this are worth interrupting a day for. Not
# zero on purpose: an alert that fires on everything is an alert nobody reads,
# and the full list is still in Discover either way.
# LIGHTHOUSE_ALERT_MIN_MATCH=30

# A burst from one feed becomes one digest of at most this many, not forty
# separate emails.
# LIGHTHOUSE_ALERT_MAX_ITEMS=25
