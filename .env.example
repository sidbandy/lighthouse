# Lighthouse configuration.
# Copy to .env and edit. Every setting is read by pydantic-settings using the
# LIGHTHOUSE_ prefix; values shown here are the defaults used in local dev.

# SQLAlchemy URL for the local Postgres 16 database (pgvector required).
LIGHTHOUSE_DATABASE_URL=postgresql+psycopg://localhost/lighthouse

# Identifier for the single operator this instance belongs to. Rows are scoped to it.
LIGHTHOUSE_OPERATOR_ID=default

# Which engine generates summaries, fit rationales, and briefings.
# "rule_based" is fully offline: no API key, no network calls, no cost.
# Set to "gemini" only if you have supplied a key below.
LIGHTHOUSE_LLM_PROVIDER=rule_based

# OPTIONAL. Only needed when LIGHTHOUSE_LLM_PROVIDER=gemini. Leave blank otherwise.
LIGHTHOUSE_GEMINI_API_KEY=

# Gemini model name, ignored unless the gemini provider is active.
LIGHTHOUSE_GEMINI_MODEL=gemini-2.0-flash

# Local sentence-transformers model used for semantic search (extras: embeddings).
LIGHTHOUSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector width of the embedding model above. Must match the pgvector column size.
LIGHTHOUSE_EMBEDDING_DIM=384

# User-Agent sent by every outbound connector request. Keep it identifiable.
LIGHTHOUSE_USER_AGENT=lighthouse/0.1 (+self-hosted job search)

# Per-request timeout, in seconds, for outbound HTTP calls.
LIGHTHOUSE_HTTP_TIMEOUT_SECONDS=20
